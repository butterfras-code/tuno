{
  "name": "tuno",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --dev",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "test:browser": "npm run build && node scripts/browser-suite.mjs",
    "verify": "node scripts/verify.mjs",
    "release:check": "node scripts/release-check.mjs",
    "test:counts:browser": "node scripts/counting-plan-browser-check.mjs",
    "dev:counts": "node scripts/build.mjs --dev --counts",
    "dev:notes": "node scripts/build.mjs --dev --notes",
    "dev:walk": "node scripts/build.mjs --dev --walk"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12"
  }
}
